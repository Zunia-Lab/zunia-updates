# Local Postgres. Create the database, then run `pnpm db:migrate`.
DATABASE_URL=postgres://localhost:5432/zunia_updates

# Required to open /admin. A long random string. Never commit the real value.
ADMIN_TOKEN=

# Production keys come from the Cloudflare Turnstile widget for updates.zunialab.com.
# Left empty in development, the app uses Cloudflare's always-pass test keys.
# In production a missing secret rejects every report.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. When both are set, /admin also requires a valid Cloudflare Access JWT.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# cloudflare in production (reads CF-Connecting-IP). none keeps the rate limit coarse.
TRUST_PROXY=none
